{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:4000",
        "EXPO_PUBLIC_ENABLE_WEBSOCKET": "false",
        "EXPO_PUBLIC_MOCK_API": "false",
        "EXPO_PUBLIC_ENABLE_SUBSCRIPTION_MOCK": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "distribution": "internal"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ejoi-be.onrender.com",
        "EXPO_PUBLIC_IMAGE_API_URL": "https://ejoi-be-image.onrender.com",
        "EXPO_PUBLIC_ENABLE_WEBSOCKET": "false",
        "EXPO_PUBLIC_MOCK_API": "false",
        "EXPO_PUBLIC_ENABLE_SUBSCRIPTION_MOCK": "false",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "159050225519-7gqrkndpp9bo5c632soe5rqfoe7p3vm9.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "159050225519-7gqrkndpp9bo5c632soe5rqfoe7p3vm9.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "159050225519-7gqrkndpp9bo5c632soe5rqfoe7p3vm9.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "159050225519-7gqrkndpp9bo5c632soe5rqfoe7p3vm9.apps.googleusercontent.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "distribution": "store"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ejoi-be.onrender.com",
        "EXPO_PUBLIC_IMAGE_API_URL": "https://ejoi-be-image.onrender.com",
        "EXPO_PUBLIC_ENABLE_WEBSOCKET": "false",
        "EXPO_PUBLIC_MOCK_API": "false",
        "EXPO_PUBLIC_ENABLE_SUBSCRIPTION_MOCK": "false",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "159050225519-7gqrkndpp9bo5c632soe5rqfoe7p3vm9.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "159050225519-7gqrkndpp9bo5c632soe5rqfoe7p3vm9.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "159050225519-7gqrkndpp9bo5c632soe5rqfoe7p3vm9.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "159050225519-7gqrkndpp9bo5c632soe5rqfoe7p3vm9.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "",
        "ascAppId": "",
        "appleTeamId": ""
      }
    }
  }
}
