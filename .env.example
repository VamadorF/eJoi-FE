# ============================================================
# CONFIGURACION DE ENTORNO - eJoi Frontend
# ============================================================
# Copiá este archivo: cp .env.example .env
# y completá los valores según tu entorno.
# ============================================================

# ------------------------------------------------------------
# URL del Backend (NestJS en puerto 4000)
# ------------------------------------------------------------
# Para correr en SIMULADOR o WEB:
#   EXPO_PUBLIC_API_URL=http://localhost:4000
#
# Para correr en CELULAR FISICO (Expo Go / Development Build):
#   Reemplazá con la IP local de tu PC en la red WiFi.
#   Para encontrar tu IP:
#     Mac/Linux: ifconfig | grep "inet " | grep -v 127.0.0.1
#     Windows:   ipconfig | findstr "IPv4"
#   Ejemplo:
#   EXPO_PUBLIC_API_URL=http://192.168.1.100:4000
#
# IMPORTANTE: El celular y la PC deben estar en la misma red WiFi.
EXPO_PUBLIC_API_URL=http://localhost:4000

# ------------------------------------------------------------
# WebSocket (actualmente deshabilitado)
# ------------------------------------------------------------
# Mismo criterio que API_URL: usar IP local para celular fisico.
EXPO_PUBLIC_SOCKET_URL=ws://localhost:3001
EXPO_PUBLIC_ENABLE_WEBSOCKET=false

# ------------------------------------------------------------
# Flags de desarrollo
# ------------------------------------------------------------
EXPO_PUBLIC_ENABLE_SUBSCRIPTION_MOCK=true

# ------------------------------------------------------------
# Image generation API (servicio externo - no requiere cambios)
# ------------------------------------------------------------
EXPO_PUBLIC_IMAGE_API_URL=https://ejoi-be-image.onrender.com

# ------------------------------------------------------------
# OAuth credentials
# ------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_APPLE_CLIENT_ID=
