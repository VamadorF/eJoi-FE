# Backend API URL
# Local development: http://localhost:4000
# Production (Render): https://ejoi-be.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:4000

# WebSocket URL (disabled until backend supports it)
EXPO_PUBLIC_SOCKET_URL=ws://localhost:3001
EXPO_PUBLIC_ENABLE_WEBSOCKET=false

# Subscription mock (true for dev, false for production)
EXPO_PUBLIC_ENABLE_SUBSCRIPTION_MOCK=true

# Mock API (set to true for offline development)
EXPO_PUBLIC_MOCK_API=false

# Image generation API (eJoi-BE-Image)
EXPO_PUBLIC_IMAGE_API_URL=https://ejoi-be-image.onrender.com

# OAuth credentials (Google)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# OAuth credentials (Apple)
EXPO_PUBLIC_APPLE_CLIENT_ID=
