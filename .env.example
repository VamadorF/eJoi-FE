# Backend API URL (backend runs on port 4000 by default)
EXPO_PUBLIC_API_URL=http://localhost:4000

# WebSocket URL (disabled until backend supports it)
EXPO_PUBLIC_SOCKET_URL=ws://localhost:3001
EXPO_PUBLIC_ENABLE_WEBSOCKET=false

# Image generation API (eJoi-BE-Image)
EXPO_PUBLIC_IMAGE_API_URL=https://ejoi-be-image.onrender.com

# OAuth credentials
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_APPLE_CLIENT_ID=
